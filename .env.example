# JWT secret for auth tokens (REQUIRED - change this!)
JWT_SECRET=your-strong-random-secret-here

# Mistral AI API key for incident enhancement (optional - leave blank to skip AI)
MISTRAL_API_KEY=your-mistral-api-key-here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://your-web-dashboard.vercel.app

# Database path (default: ./patrol.db)
# DB_PATH=./patrol.db

# Port (default: 3000)
# PORT=3000
