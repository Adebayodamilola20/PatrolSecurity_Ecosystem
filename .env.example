# JWT secret for auth tokens (REQUIRED - change this!)
JWT_SECRET=your-strong-random-secret-here

# Resend Email API (REQUIRED for report auto-emailing, emergency alerts, etc.)
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=reports@yourdomain.com

# Termii SMS API (optional - needed for emergency SMS alerts)
# Get your key at https://termii.com
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=PatrolAlert
TERMII_BASE_URL=https://api.termii.com

# Mistral AI API key for incident enhancement (optional)
MISTRAL_API_KEY=your-mistral-api-key-here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://your-web-dashboard.vercel.app

# Database (default: SQLite ./patrol.db, set DATABASE_URL for PostgreSQL)
# DB_PATH=./patrol.db
# DATABASE_URL=postgresql://user:pass@host:5432/patrol

# Server port (default: 3000)
# PORT=3000

# Report scheduler interval in minutes (default: 60)
# REPORT_SCHEDULE_INTERVAL_MINUTES=60
