<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Tarmac tracks only during a shift, through the location foreground
         service started at clock-in (with its "On duty" notification). That
         keeps working with the phone pocketed on "while using the app"
         permission, so the "all the time" permission Google reviews strictly
         is removed from this build. Evergreen keeps it. -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />
</manifest>
