<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Patrol App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>patrol_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Camera is used to scan QR codes at checkpoints</string>
	<!-- Tracking continues while the phone is pocketed and the app closed.
	     Without the Always permission AND the location background mode below,
	     iOS suspends the app on the home button and position updates stop
	     dead: a guard's dot froze wherever they last had the app open and
	     stayed there for days. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Your location is shared with the control room for the whole of your shift, including while the app is closed, so supervisors can see where you are and send help to the right place. Tracking stops when you clock out.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Your location is shared with the control room for the whole of your shift, including while the app is closed. Tracking stops when you clock out.</string>
	<!-- Without this dictionary iOS refuses the temporary full-accuracy
	     prompt outright, so a guard whose Precise Location is off can never
	     be asked for it and every scan fails on a fuzzed ~1400m reading. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>PatrolScan</key>
		<string>Exact location is needed to confirm you are standing at the checkpoint. Without it a patrol scan cannot be verified.</string>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to verify you are at the checkpoint</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photos can be attached to scan reports</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Required for background tracking. See the Always-permission note
	     above; removing either one breaks the same thing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
