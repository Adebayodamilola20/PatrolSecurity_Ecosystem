# Configuration reference for the four deployable surfaces.
#
# This file is documentation, not a file you copy to .env. Nothing reads a .env
# at the repo root any more -- the Node/SQLite server that did was removed. Each
# surface below reads its own configuration from its own place.

# ---------------------------------------------------------------------------
# 1. Convex backend  (mobile/patrol_app/convex)
# ---------------------------------------------------------------------------
# Set with:  npx convex env set NAME value --prod
# Inspect:   npx convex env list --prod
# CONVEX_URL, CONVEX_SITE_URL and CONVEX_DEPLOYMENT are injected automatically.

PATROL_JWT_SECRET=            # REQUIRED. Signing key for auth tokens.
RESEND_API_KEY=               # REQUIRED. Report emails and alert delivery.
RESEND_FROM_EMAIL=            # REQUIRED. Must be on a Resend-verified domain.
TERMII_API_KEY=               # REQUIRED. Emergency SMS.
TERMII_SENDER_ID=
TERMII_BASE_URL=              # Optional; defaults to https://v3.api.termii.com/api

# Optional tuning. Each has a working default in convex/env.ts.
# GPS_POSITION_RETENTION_DAYS=30
# GPS_MIN_DISTANCE_METERS=20
# GPS_MAX_INTERVAL_MINUTES=5
# UPLOAD_ORPHAN_TTL_HOURS=24
# PHOTO_URL_TTL_SECONDS=600
# GLOBAL_RATE_LIMIT_PER_SECOND=150

# Backend crash reporting. Convex's own Sentry integration is Pro-only, so
# convex/lib/sentry.ts posts to the ingest API directly. Unset = reporting off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=          # Defaults to the Convex deployment name.
# SENTRY_RELEASE=

# DEV_SEED_SECRET must never be set in production -- it unlocks /dev/seed.

# ---------------------------------------------------------------------------
# 2. Staff dashboard  (web/)  -- .env.local locally, Vercel env vars in deploy
# ---------------------------------------------------------------------------
VITE_API_URL=                 # REQUIRED. e.g. https://<deployment>.convex.site
VITE_CLERK_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=     # Browser key; restrict by HTTP referrer.
# VITE_SENTRY_DSN=            # Unset = the SDK stays off entirely.
# VITE_SENTRY_ENVIRONMENT=    # Defaults to Vite's mode.
# VITE_SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# 3. Client portal  (web-client/)
# ---------------------------------------------------------------------------
# Same VITE_API_URL and VITE_SENTRY_* keys as above, pointed at its own Sentry
# project so client-facing errors do not mix with staff ones.

# ---------------------------------------------------------------------------
# 4. Flutter app  (mobile/patrol_app)
# ---------------------------------------------------------------------------
# Compiled in, not read at runtime:
#   flutter build apk --dart-define=SENTRY_DSN=... --dart-define=SENTRY_RELEASE=...
# Omitting SENTRY_DSN builds an app with crash reporting disabled.

# ---------------------------------------------------------------------------
# Source map upload (build machine / CI only, all three JS+Flutter builds)
# ---------------------------------------------------------------------------
# Without these the Vite builds skip upload and stack traces stay minified.
# SENTRY_AUTH_TOKEN=          # Write-scoped. Never commit; never a VITE_ var.
# SENTRY_ORG=
# SENTRY_PROJECT=
